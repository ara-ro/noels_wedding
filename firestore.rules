rules_version = '2';

// PLAN.md 5.3/5.4 참고: 업로드 시 이름+코드(1107)를 함께 기록하도록 강제해
// 클라이언트 우회(개발자도구 직접 호출)로도 코드 검증을 건너뛸 수 없게 함.
service cloud.firestore {
  match /databases/{database}/documents {
    match /guestPhotos/{photoId} {
      allow read: if true;

      allow create: if
        request.resource.data.code == '1107' &&
        request.resource.data.keys().hasAll(['url', 'uploaderName', 'code', 'createdAt']) &&
        request.resource.data.uploaderName is string &&
        request.resource.data.uploaderName.size() <= 40 &&
        request.resource.data.url is string;

      // 부적절한 사진 삭제는 Firebase 콘솔에서 관리자가 수동으로 처리 (PLAN.md 5.4, 10.1 확정 사항)
      allow update, delete: if false;
    }
  }
}
